---
import fs from 'node:fs';
import path from 'node:path';

const root = path.join(process.cwd(), 'public', 'downloads');
const labels: Record<string, string> = {
  '01-clinic-profile': '1 · Clinic Profile',
  '02-patient-notice': '2 · Patient notice',
  '03-ropa': '3 · Record of processing',
  '04-retention': '4 · Retention schedule',
  '05-data-subject-rights': '5 · Data subject rights',
  '06-incidents': '6 · Security incidents',
  '07-security-policy': '7 · Security policy',
  '08-training': '8 · Staff training',
  '09-providers': '9 · Providers and Art. 28',
  '10-cctv-lia': '10 · CCTV and legitimate interest',
  '11-employee-notice': '11 · Employee notice',
  '12-dpia': '12 · DPIA process',
  '13-methodology': '13 · Methodology',
  '14-self-assessment': '14 · Self-assessment',
};
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const dirs = fs.existsSync(root) ? fs.readdirSync(root, { withFileTypes: true }).filter((d) => d.isDirectory()).map((d) => d.name).sort() : [];
const groups = dirs.map((dir) => ({
  dir,
  label: labels[dir] ?? dir,
  files: fs.readdirSync(path.join(root, dir)).sort().map((f) => {
    const kb = Math.max(1, Math.round(fs.statSync(path.join(root, dir, f)).size / 1024));
    const ext = path.extname(f).slice(1).toUpperCase();
    const kind = f.toLowerCase().includes('blank') ? 'blank template' : ext === 'CSV' ? 'spreadsheet' : ext === 'DOCX' ? 'Word document' : ext;
    return { name: f, href: `${base}/downloads/${dir}/${f}`, kb, kind };
  }),
}));
const total = groups.reduce((n, g) => n + g.files.length, 0);
---
<p>{total} files in {groups.length} folders. Word files open in any word processor; the spreadsheets are plain CSV (UTF-8) and open in any spreadsheet tool.</p>
{groups.map((g) => (
  <>
    <h2 id={g.dir}>{g.label}</h2>
    <ul>
      {g.files.map((f) => (
        <li><a href={f.href}>{f.name}</a> <small>({f.kind}, {f.kb} KB)</small></li>
      ))}
    </ul>
  </>
))}
