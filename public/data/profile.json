  "params": [
    {
      "Parameter": "Response time to a data subject request",
      "Value": "1 month (Art. 12(3)), clinic target 30 days, extendable by 2 months if complex"
    },
    {
      "Parameter": "Breach notification to the authority",
      "Value": "Within 72 hours of becoming aware, unless unlikely to result in risk"
    },
    {
      "Parameter": "Internal escalation of a suspected incident",
      "Value": "Immediately, to the incident lead (S-01)"
    },
    {
      "Parameter": "Staff report of an incident",
      "Value": "Immediately, at most 1 hour from noticing (working hours); deputy incident lead: Nurse C (S-03), who also calls the external privacy adviser if Dr. A is unreachable"
    },
    {
      "Parameter": "Initial incident assessment",
      "Value": "Within 24 hours of the report"
    },
    {
      "Parameter": "Post-incident review",
      "Value": "Within 30 days of closing the incident"
    },
    {
      "Parameter": "Breach register retention",
      "Value": "5 years from closing the incident (RET-10)"
    },
    {
      "Parameter": "Vendor notification of a breach to the clinic",
      "Value": "Without delay, within 24 hours of becoming aware (set in the Art. 28 agreement)"
    },
    {
      "Parameter": "Reception forwards a patient request to the privacy contact",
      "Value": "Within one working day"
    },
    {
      "Parameter": "CCTV retention",
      "Value": "7 days, absolute maximum 30 days"
    },
    {
      "Parameter": "Promotional contacts",
      "Value": "Until consent is withdrawn, maximum 24 months after last interaction or last consent confirmation"
    },
    {
      "Parameter": "Staff training",
      "Value": "On joining and annually; short role-based session (about 15–20 minutes extra for clinical and reception staff) plus a 5-question mini-test; record kept"
    },
    {
      "Parameter": "Training format",
      "Value": "New joiners: 45 minutes before they get access to data. Annual refresher: 45 minutes, held each December with the incident drill. Role part: 15–20 minutes extra. Mini-test: 5 questions drawn from a bank of 10. Records kept with the personnel file (RET-11(a)). First programme session: 19 January 2027"
    },
    {
      "Parameter": "Incident drill",
      "Value": "Annually, three rotating scenarios"
    },
    {
      "Parameter": "Register reviews",
      "Value": "ROPA and retention reviewed annually and on any new system or vendor"
    },
    {
      "Parameter": "Access review",
      "Value": "Periodically (clinic proposal: every 6 months; the security policy leaves the interval to be completed)"
    },
    {
      "Parameter": "Destruction of records past retention",
      "Value": "Once a year, logged in the destruction register"
    },
    {
      "Parameter": "Backup rotation",
      "Value": "Backups are overwritten after at most 3 months"
    },
    {
      "Parameter": "Password rule",
      "Value": "At least 12 characters or a passphrase, unique per account; password manager recommended"
    },
    {
      "Parameter": "Two-step verification",
      "Value": "Required for e-mail, cloud storage and the practice software where the provider offers it"
    },
    {
      "Parameter": "Screen lock",
      "Value": "Automatic after at most 5 minutes"
    },
    {
      "Parameter": "Critical security updates",
      "Value": "Applied within 7 days"
    },
    {
      "Parameter": "Clinic's own backups (non-clinical files)",
      "Value": "Weekly, encrypted, one copy kept off the premises; restore test quarterly"
    },
    {
      "Parameter": "Maximum accepted downtime of the practice software",
      "Value": "4 hours, then paper forms"
    },
    {
      "Parameter": "Access-log spot check",
      "Value": "Quarterly"
    },
    {
      "Parameter": "Security baseline assessment",
      "Value": "December 2026 (38 controls, status and owner per control); repeated yearly"
    },
    {
      "Parameter": "Consent for marketing",
      "Value": "Separate, opt-in, withdrawable at any time"
    },
    {
      "Parameter": "Patient acknowledgement of the notice",
      "Value": "Confirms reading only; not consent"
    }
  ],
